# ============================================================
# Polymarket Sports Arbitrage Bot — Environment Config
# Copy this to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# ── Mode ──────────────────────────────────────────────────────
# true  = log trades, don't execute (safe for testing)
# false = live execution with real USDC
DEMO_MODE=true

# ── Polymarket credentials ─────────────────────────────────────
# Get from polymarket.com → Profile Settings
POLY_PRIVATE_KEY=your_wallet_private_key_here
POLY_FUNDER_ADDRESS=0xYourWalletAddressHere
POLY_CHAIN_ID=137

# ── Sports odds data ───────────────────────────────────────────
# Sign up at https://the-odds-api.com (free tier: 500 req/month)
ODDS_API_KEY=your_odds_api_key_here

# ── Capital & risk ─────────────────────────────────────────────
BANKROLL_USDC=500
DAILY_LOSS_LIMIT_USD=50
MAX_POSITION_PCT=0.05
MAX_OPEN_POSITIONS=3

# ── Strategy parameters ────────────────────────────────────────
MIN_EDGE=0.08
MIN_CONFIDENCE=0.70
KELLY_FRACTION=0.25
SLIPPAGE_TOLERANCE=0.02

# ── Operational ────────────────────────────────────────────────
SCAN_INTERVAL_SEC=600
