# ============================================================
# ProArb V2 -- Value Betting Engine -- Environment Config
# Copy this to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# -- Mode ----------------------------------------------------------
DEMO_MODE=true              # true = log trades, don't execute (safe for testing)
LOG_LEVEL=INFO

# -- Bankroll ------------------------------------------------------
BANKROLL_USDC=500           # Minimum viable. $108 was too small.
MIN_BANKROLL=20             # Stop-loss floor

# -- Edge & Sizing -------------------------------------------------
MIN_EDGE=0.10               # 10% minimum Pinnacle-Polymarket gap
KELLY_FRACTION=0.25         # Quarter Kelly
MAX_POSITION_PCT=0.05       # 5% max per trade
MIN_STAKE=5.0               # Minimum $5 per trade

# -- Risk ----------------------------------------------------------
MAX_OPEN_POSITIONS=10
MAX_DAILY_TRADES=15
DAILY_LOSS_LIMIT_PCT=0.20   # 20% daily drawdown limit
MAX_SPORT_EXPOSURE_PCT=0.15 # 15% max in single sport

# -- Data Sources --------------------------------------------------
# The Odds API: sign up at https://the-odds-api.com
# Free tier: 500 credits/month. Recommended: $29/month (1,500 credits)
ODDS_API_KEY=your_key_here
ODDS_API_POLL_INTERVAL=600  # 10 minutes (in seconds)
ACTIVE_SPORTS=basketball_nba,americanfootball_nfl,baseball_mlb,soccer_epl

# -- Polymarket ----------------------------------------------------
POLYMARKET_PK=your_private_key
POLYMARKET_FUNDER=your_funder_address
POLY_CHAIN_ID=137
ORDER_EXPIRY_SEC=600        # Cancel unfilled orders after 10 min
MIN_LIQUIDITY=5000          # Skip markets with < $5k volume
MAX_SPREAD=0.04             # Skip markets with > 4c spread

# -- ESPN (outcomes only) ------------------------------------------
ESPN_POLL_INTERVAL=60       # Every 60 seconds
